rules_version = '2';

// Firebase 프로젝트: wedding-log-ab8be (기존 웨딩플래너와 새 사이트가 함께 씀)
// 공개 레포 + 공개 Firebase 설정값이므로 이 규칙이 데이터를 지키는 유일한 방어선입니다.
// 적용: Firebase 콘솔 → Firestore Database → 규칙 탭에 이 파일 내용을 붙여넣고 「게시」
service cloud.firestore {
  match /databases/{database}/documents {

    // 데이터를 고칠 수 있는 계정(uid) 목록.
    // Firebase 콘솔 → Authentication → 사용자 에서 웨딩플래너에 로그인하던 계정들의 uid 를 모두 넣으세요.
    // 예: ['abc123...', 'def456...']
    function isOwner() {
      return request.auth != null
        && request.auth.uid in ['FHgQUGnrkMg09NkPvr85at60lg53', 'kNFjbUsuOIa3Vx0CSmU2df83NIj2'];
    }

    // ───── 웨딩플래너: 누구나 보는 공개 페이지(timeline.html, invite.html)가 읽는 문서 ─────
    match /app/settings {
      allow read: if true;
      allow write: if isOwner();
    }
    match /app/checklist {
      allow read: if true;
      allow write: if isOwner();
    }
    match /app/invitation {
      allow read: if true;
      allow write: if isOwner();
    }
    match /invitationPhotos/{photoId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ───── 웨딩플래너: 주인만 (지출 장부, 정보 메모, 시안, 하객 명단) ─────
    match /app/expenses {
      allow read, write: if isOwner();
    }
    match /app/infosheet {
      allow read, write: if isOwner();
    }
    match /moodboardBoards/{id} {
      allow read, write: if isOwner();
    }
    match /moodboardSections/{id} {
      allow read, write: if isOwner();
    }
    match /guests/{id} {
      allow read, write: if isOwner();
    }

    // ───── 가계부 ─────
    function validTransaction() {
      let d = request.resource.data;
      return d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.kind in ['income', 'expense']
        && d.amount is int && d.amount > 0
        && d.categoryId is string;
    }

    match /ledger_categories/{id} {
      allow read, write: if isOwner();
    }
    match /ledger_transactions/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validTransaction();
    }

    // 위에 적지 않은 경로는 모두 막습니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
