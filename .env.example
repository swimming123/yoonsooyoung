# Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹)에서 복사하세요.
# 이 값들은 브라우저에 그대로 노출되는 공개 값입니다. 데이터 보호는 firestore.rules가 담당합니다.
# 로컬 개발: 이 파일을 .env.local 로 복사해서 채우세요.
# 배포: GitHub 레포 Settings → Secrets and variables → Actions → Variables 에 같은 이름으로 등록하세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 사이트 주인 uid(쉼표로 여러 명). 화면에서 메뉴를 보여줄지 정하는 용도일 뿐,
# 실제 접근 제한은 firestore.rules 의 owner 목록이 합니다.
VITE_OWNER_UIDS=
